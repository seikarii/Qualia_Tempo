{
  "name": "qualia-tempo-frontend",
  "version": "1.0.0",
  "description": "Qualia Tempo - Rhythm Action Game Frontend",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "tsc && vite build",
    "build:electron": "vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "lint:crisalida": "eslint 'src/**/*.{ts,tsx}' --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:connection": "node -e \"fetch('http://localhost:8000/health').then(r=>r.json()).then(console.log).catch(console.error)\""
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "inversify": "^7.10.0",
    "js-yaml": "^4.1.0",
    "playwright": "^1.55.0",
    "puppeteer-core": "^24.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.2.2",
    "three": "^0.180.0",
    "tone": "^14.9.17",
    "zod": "^4.1.8",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@qualia-tempo/eslint-plugin-qualia-code": "file:../../eslint-plugin-qualia-code",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0",
    "whatwg-fetch": "^3.6.20"
  },
  "build": {
    "appId": "com.qualia.tempo",
    "productName": "Qualia Tempo",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.js"
    ]
  }
}
