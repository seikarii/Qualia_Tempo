/**
 * RhythmicMovementController.test.ts - Simplified Approach
 * Tests for rhythm game logic without complex decorator mocking
 */

import { jest } from '@jest/globals';

// Simple decorator mocks that don't interfere
jest.mock('../utils/decorators', () => ({
  logMethod: () => (_target: any, _propertyKey: string, descriptor: PropertyDescriptor) => descriptor,
  catchError: () => (_target: any, _propertyKey: string, descriptor: PropertyDescriptor) => descriptor,
  throttle: (_ms: number) => (_target: any, _propertyKey: string, descriptor: PropertyDescriptor) => descriptor
}));

import { RhythmicMovementController } from '../services/RhythmicMovementController';
import { EventBus } from '../services/EventBus';

// Mock performance.now
const mockPerformanceNow = jest.fn();
global.performance = { now: mockPerformanceNow } as any;

// Mock document event listeners
const mockAddEventListener = jest.fn();
const mockRemoveEventListener = jest.fn();
global.document = {
  addEventListener: mockAddEventListener,
  removeEventListener: mockRemoveEventListener
} as any;

// Mock window.setInterval and clearInterval
const mockSetInterval = jest.fn().mockReturnValue(123);
const mockClearInterval = jest.fn();
global.window = {
  setInterval: mockSetInterval as any,
  clearInterval: mockClearInterval as any
} as any;

// Mock console methods
const mockConsoleLog = jest.spyOn(console, 'log').mockImplementation(() => {});
const mockConsoleWarn = jest.spyOn(console, 'warn').mockImplementation(() => {});

describe('RhythmicMovementController', () => {
  let eventBus: EventBus;
  let configService: any;
  let controller: RhythmicMovementController;
  let mockEventBusEmit: jest.MockedFunction<EventBus['emit']>;

  beforeEach(() => {
    jest.clearAllMocks();
    
    // Create mock EventBus
    eventBus = {
      emit: jest.fn(),
      subscribe: jest.fn(),
      unsubscribe: jest.fn(),
      once: jest.fn(),
      clear: jest.fn()
    } as any;
    
    // Create mock ConfigurationService
    configService = {
      getConfig: jest.fn().mockReturnValue({
        services: {
          rhythmicMovement: {
            bpm: 120,
            perfectTiming: 100,
            goodTiming: 200,
            gridSize: 8,
            slowdownFactor: 1.0, // Start at normal speed
            slowdownDuration: 2000,
            keyThrottleMs: 100
          }
        }
      })
    };
    
    mockEventBusEmit = eventBus.emit as jest.MockedFunction<EventBus['emit']>;
    
    // Mock performance.now to return predictable values
    mockPerformanceNow.mockReturnValue(1000);
    
    // Mock setInterval to return a mock interval ID
    mockSetInterval.mockReturnValue(123);
    
    // Create controller instance
    controller = new RhythmicMovementController(eventBus, configService);
  });

  afterAll(() => {
    mockConsoleLog.mockRestore();
    mockConsoleWarn.mockRestore();
  });

  describe('Constructor', () => {
    it('should initialize with default values', () => {
      // Verify that constructor doesn't throw and creates instance
      expect(controller).toBeInstanceOf(RhythmicMovementController);
      
      // Test a public method to ensure object is functional
      expect(controller.getPlayerPosition()).toEqual([4, 4]); // Center of 8x8 grid
    });

    it('should handle configuration loading', () => {
      // Verify that getConfig was called during construction
      expect(configService.getConfig).toHaveBeenCalled();
    });
  });

  describe('Service Lifecycle', () => {
    it('should start successfully (direct method call)', () => {
      // Test the startMetronome and setupKeyboardListeners methods directly by spying
      const originalSetupKeyboard = (controller as any).setupKeyboardListeners;
      const originalStartMetronome = (controller as any).startMetronome;
      
      const spySetupKeyboard = jest.fn();
      const spyStartMetronome = jest.fn();
      
      (controller as any).setupKeyboardListeners = spySetupKeyboard;
      (controller as any).startMetronome = spyStartMetronome;
      
      controller.start();
      
      expect(spySetupKeyboard).toHaveBeenCalled();
      expect(spyStartMetronome).toHaveBeenCalled();
      
      // Restore original methods
      (controller as any).setupKeyboardListeners = originalSetupKeyboard;
      (controller as any).startMetronome = originalStartMetronome;
    });

    it('should not start if already running', () => {
      controller.start();
      jest.clearAllMocks();
      
      controller.start();
      
      expect(mockConsoleWarn).toHaveBeenCalledWith('RhythmicMovementController already started');
      expect(mockAddEventListener).not.toHaveBeenCalled();
    });

    it('should stop successfully', () => {
      controller.start();
      jest.clearAllMocks();
      
      controller.stop();
      
      expect(mockRemoveEventListener).toHaveBeenCalledWith('keydown', expect.any(Function));
      expect(mockClearInterval).toHaveBeenCalledWith(123);
      expect(mockConsoleLog).toHaveBeenCalledWith('🎵 RhythmicMovementController stopped');
    });

    it('should not stop if not running', () => {
      controller.stop();
      
      expect(mockConsoleWarn).toHaveBeenCalledWith('RhythmicMovementController not running');
      expect(mockRemoveEventListener).not.toHaveBeenCalled();
    });
  });

  describe('Metronome Functionality', () => {
    it('should emit metronome tick events', () => {
      controller.start();
      
      // Get the interval callback and call it
      const intervalCallback = mockSetInterval.mock.calls[0][0] as Function;
      mockPerformanceNow.mockReturnValue(2000);
      
      intervalCallback();
      
      expect(mockEventBusEmit).toHaveBeenCalledWith({
        type: 'MetronomeTick',
        beatNumber: 1,
        bpm: 120,
        timestamp: 2000
      });
    });

    it('should increment beat number on each tick', () => {
      controller.start();
      const intervalCallback = mockSetInterval.mock.calls[0][0] as Function;
      
      // First tick
      mockPerformanceNow.mockReturnValue(1000);
      intervalCallback();
      
      // Second tick
      mockPerformanceNow.mockReturnValue(1500);
      intervalCallback();
      
      expect(mockEventBusEmit).toHaveBeenCalledTimes(2);
      expect(mockEventBusEmit).toHaveBeenNthCalledWith(1, expect.objectContaining({ beatNumber: 1 }));
      expect(mockEventBusEmit).toHaveBeenNthCalledWith(2, expect.objectContaining({ beatNumber: 2 }));
    });
  });

  describe('Keyboard Input Handling', () => {
    beforeEach(() => {
      controller.start();
    });

    it('should handle WASD movement keys', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      // Test W key (north)
      const wEvent = { key: 'w', preventDefault: jest.fn() };
      keydownHandler(wEvent);
      
      expect(wEvent.preventDefault).toHaveBeenCalled();
      expect(mockEventBusEmit).toHaveBeenCalledWith(
        expect.objectContaining({
          type: 'RhythmicDash',
          direction: 'north'
        })
      );
    });

    it('should handle arrow keys', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      // Test ArrowUp (north)
      const arrowEvent = { key: 'ArrowUp', preventDefault: jest.fn() };
      keydownHandler(arrowEvent);
      
      expect(arrowEvent.preventDefault).toHaveBeenCalled();
      expect(mockEventBusEmit).toHaveBeenCalledWith(
        expect.objectContaining({
          type: 'RhythmicDash',
          direction: 'north'
        })
      );
    });

    it('should ignore invalid keys', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      const invalidEvent = { key: 'x', preventDefault: jest.fn() };
      keydownHandler(invalidEvent);
      
      expect(invalidEvent.preventDefault).not.toHaveBeenCalled();
      expect(mockEventBusEmit).not.toHaveBeenCalled();
    });

    it('should map all movement keys correctly', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      const testCases = [
        { key: 'w', direction: 'north' },
        { key: 'W', direction: 'north' },
        { key: 's', direction: 'south' },
        { key: 'S', direction: 'south' },
        { key: 'd', direction: 'east' },
        { key: 'D', direction: 'east' },
        { key: 'a', direction: 'west' },
        { key: 'A', direction: 'west' },
        { key: 'ArrowUp', direction: 'north' },
        { key: 'ArrowDown', direction: 'south' },
        { key: 'ArrowRight', direction: 'east' },
        { key: 'ArrowLeft', direction: 'west' }
      ];
      
      testCases.forEach(({ key, direction }) => {
        jest.clearAllMocks();
        const event = { key, preventDefault: jest.fn() };
        keydownHandler(event);
        
        expect(mockEventBusEmit).toHaveBeenCalledWith(
          expect.objectContaining({
            type: 'RhythmicDash',
            direction
          })
        );
      });
    });
  });

  describe('Movement and Position Logic', () => {
    beforeEach(() => {
      controller.start();
    });

    it('should calculate new positions correctly', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      // Starting position should be [4, 4] (center)
      expect(controller.getPlayerPosition()).toEqual([4, 4]);
      
      // Move north (decrease z)
      const northEvent = { key: 'w', preventDefault: jest.fn() };
      keydownHandler(northEvent);
      
      expect(mockEventBusEmit).toHaveBeenCalledWith(
        expect.objectContaining({
          newPosition: [4, 3]
        })
      );
    });

    it('should update player position on valid moves', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      // Move north
      const northEvent = { key: 'w', preventDefault: jest.fn() };
      keydownHandler(northEvent);
      
      expect(controller.getPlayerPosition()).toEqual([4, 3]);
    });

    it('should not move outside grid boundaries', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      // Try to move outside the 8x8 grid
      // Move to edge first
      for (let i = 0; i < 5; i++) {
        const westEvent = { key: 'a', preventDefault: jest.fn() };
        keydownHandler(westEvent);
      }
      
      // Now at position [0, 4] - left edge
      expect(controller.getPlayerPosition()[0]).toBe(0);
      
      // Try to move further west (should be blocked)
      jest.clearAllMocks();
      const invalidWestEvent = { key: 'a', preventDefault: jest.fn() };
      keydownHandler(invalidWestEvent);
      
      // Position should remain at edge
      expect(controller.getPlayerPosition()[0]).toBe(0);
    });
  });

  describe('Timing and Rhythm Analysis', () => {
    beforeEach(() => {
      controller.start();
      // Simulate a beat
      const intervalCallback = mockSetInterval.mock.calls[0][0] as Function;
      mockPerformanceNow.mockReturnValue(1000);
      intervalCallback();
    });

    it('should calculate perfect timing', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      // Input exactly on beat (within perfect timing window)
      mockPerformanceNow.mockReturnValue(1050); // 50ms after beat
      
      const perfectEvent = { key: 'w', preventDefault: jest.fn() };
      keydownHandler(perfectEvent);
      
      expect(mockEventBusEmit).toHaveBeenCalledWith(
        expect.objectContaining({
          timing: 'perfect'
        })
      );
    });

    it('should calculate good timing', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      // Input within good timing window
      mockPerformanceNow.mockReturnValue(1150); // 150ms after beat
      
      const goodEvent = { key: 'w', preventDefault: jest.fn() };
      keydownHandler(goodEvent);
      
      expect(mockEventBusEmit).toHaveBeenCalledWith(
        expect.objectContaining({
          timing: 'good'
        })
      );
    });

    it('should calculate miss timing', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      // Input outside timing window
      mockPerformanceNow.mockReturnValue(1300); // 300ms after beat
      
      const missEvent = { key: 'w', preventDefault: jest.fn() };
      keydownHandler(missEvent);
      
      expect(mockEventBusEmit).toHaveBeenCalledWith(
        expect.objectContaining({
          timing: 'miss'
        })
      );
    });
  });

  describe('Player Action Events', () => {
    beforeEach(() => {
      controller.start();
    });

    it('should emit HitNote for perfect/good timing', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      // Perfect timing
      mockPerformanceNow.mockReturnValue(1050);
      const perfectEvent = { key: 'w', preventDefault: jest.fn() };
      keydownHandler(perfectEvent);
      
      expect(mockEventBusEmit).toHaveBeenCalledWith(
        expect.objectContaining({
          type: 'PlayerAction',
          action: 'HitNote',
          source: 'RhythmicMovementController'
        })
      );
    });

    it('should emit MissNote for miss timing', () => {
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      // Miss timing
      mockPerformanceNow.mockReturnValue(1300);
      const missEvent = { key: 'w', preventDefault: jest.fn() };
      keydownHandler(missEvent);
      
      expect(mockEventBusEmit).toHaveBeenCalledWith(
        expect.objectContaining({
          type: 'PlayerAction',
          action: 'MissNote',
          source: 'RhythmicMovementController'
        })
      );
    });
  });

  describe('BPM Configuration', () => {
    it('should update BPM and restart metronome', () => {
      controller.start();
      jest.clearAllMocks();
      
      controller.setBPM(140);
      
      // Should stop old metronome
      expect(mockClearInterval).toHaveBeenCalledWith(123);
      
      // Should start new metronome with new interval
      // 140 BPM = 60/140 * 1000 = 428.57ms ≈ 429ms
      expect(mockSetInterval).toHaveBeenCalledWith(expect.any(Function), 428.5714285714286);
    });

    it('should update BPM when not running', () => {
      controller.setBPM(100);
      
      // Should not affect intervals when not running
      expect(mockClearInterval).not.toHaveBeenCalled();
      expect(mockSetInterval).not.toHaveBeenCalled();
    });
  });

  describe('Edge Cases and Error Handling', () => {
    it('should handle undefined event key', () => {
      controller.start();
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      const undefinedEvent = { key: undefined, preventDefault: jest.fn() };
      keydownHandler(undefinedEvent);
      
      expect(undefinedEvent.preventDefault).not.toHaveBeenCalled();
      expect(mockEventBusEmit).not.toHaveBeenCalled();
    });

    it('should handle multiple rapid starts/stops', () => {
      controller.start();
      controller.stop();
      controller.start();
      controller.stop();
      
      expect(mockConsoleLog).toHaveBeenCalledTimes(2); // Started twice
    });

    it('should handle beat time synchronization edge cases', () => {
      controller.start();
      const intervalCallback = mockSetInterval.mock.calls[0][0] as Function;
      const keydownHandler = mockAddEventListener.mock.calls[0][1] as Function;
      
      // Beat at time 1000
      mockPerformanceNow.mockReturnValue(1000);
      intervalCallback();
      
      // Input just before next beat (timing should use next beat)
      mockPerformanceNow.mockReturnValue(1480); // 20ms before next beat
      
      const event = { key: 'w', preventDefault: jest.fn() };
      keydownHandler(event);
      
      expect(mockEventBusEmit).toHaveBeenCalledWith(
        expect.objectContaining({
          timing: 'perfect' // 20ms is within perfect timing
        })
      );
    });
  });
});
