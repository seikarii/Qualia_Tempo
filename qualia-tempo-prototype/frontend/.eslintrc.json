{
  "root": true,
  "env": { "browser": true, "es2020": true, "node": true },
  "extends": ["plugin:@qualia-tempo/qualia-code/recommended"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "no-console": "off"
  }
}
