{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BossState",
  "description": "Boss state data structure for Qualia Tempo",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the boss"
    },
    "name": {
      "type": "string",
      "description": "Display name of the boss"
    },
    "position": {
      "type": "object",
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      },
      "required": ["x", "y"],
      "additionalProperties": false
    },
    "health": {
      "type": "number",
      "minimum": 0,
      "description": "Current health"
    },
    "maxHealth": {
      "type": "number",
      "minimum": 0,
      "description": "Maximum health"
    },
    "currentPhase": {
      "type": "integer",
      "minimum": 0,
      "description": "Current combat phase"
    },
    "activePatterns": {
      "type": "array",
      "items": {"type": "string"},
      "description": "IDs of currently active attack patterns"
    },
    "buffs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Active boss buffs"
    },
    "debuffs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Active boss debuffs"
    },
    "currentAggressionLevel": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Current aggression level influenced by tempo and volume"
    }
  },
  "required": [
    "id",
    "name",
    "position",
    "health",
    "maxHealth",
    "currentPhase",
    "activePatterns",
    "buffs",
    "debuffs",
    "currentAggressionLevel"
  ],
  "additionalProperties": false
}
