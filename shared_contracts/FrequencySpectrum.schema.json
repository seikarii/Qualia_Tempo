{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Responsibility",
  "description": "Represents frequency spectrum data from FFT analysis.",
  "type": "object",
  "required": [
    "frequencies",
    "magnitudes",
    "sampleRate",
    "windowSize"
  ],
  "properties": {
    "frequencies": {
      "description": "Frequency bins (Hz)",
      "type": "array",
      "items": {
        "type": "number",
        "format": "float"
      }
    },
    "magnitudes": {
      "description": "Magnitude values (normalized to [0.0, 1.0])",
      "type": "array",
      "items": {
        "type": "number",
        "format": "float"
      }
    },
    "sampleRate": {
      "description": "Sample rate used for analysis",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "windowSize": {
      "description": "FFT window size",
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    }
  }
}