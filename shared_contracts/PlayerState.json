{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlayerState",
  "description": "Player state data structure",
  "type": "object",
  "properties": {
    "position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "description": "X coordinate"
        },
        "y": {
          "type": "number", 
          "description": "Y coordinate"
        }
      },
      "required": ["x", "y"],
      "additionalProperties": false
    },
    "health": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Player health (0-100)"
    },
    "combo": {
      "type": "number",
      "minimum": 0,
      "description": "Current combo count"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "description": "Current score"
    },
    "isMoving": {
      "type": "boolean",
      "description": "Whether player is currently moving"
    },
    "lastRhythmHit": {
      "type": "number",
      "minimum": 0,
      "description": "Timestamp of last rhythm hit"
    },
    "velocity": {
      "type": "object",
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      },
      "required": ["x", "y"],
      "description": "Player velocity vector"
    },
    "abilities": {
      "type": "object",
      "properties": {
        "dash": {
          "type": "object",
          "properties": {
            "isReady": {"type": "boolean"},
            "cooldownRemaining": {"type": "number", "minimum": 0}
          },
          "required": ["isReady", "cooldownRemaining"]
        },
        "parry": {
          "type": "object",
          "properties": {
            "isReady": {"type": "boolean"},
            "cooldownRemaining": {"type": "number", "minimum": 0}
          },
          "required": ["isReady", "cooldownRemaining"]
        },
        "ultimate": {
          "type": "object",
          "properties": {
            "isActive": {"type": "boolean"},
            "charge": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "required": ["isActive", "charge"]
        }
      },
      "required": ["dash", "parry", "ultimate"],
      "description": "Player ability states"
    },
    "buffs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "durationRemaining": {"type": "number", "minimum": 0}
        },
        "required": ["id", "name", "durationRemaining"]
      },
      "description": "Active buffs"
    },
    "debuffs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "durationRemaining": {"type": "number", "minimum": 0}
        },
        "required": ["id", "name", "durationRemaining"]
      },
      "description": "Active debuffs"
    }
  },
  "required": [
    "position",
    "health",
    "combo", 
    "score",
    "isMoving",
    "lastRhythmHit",
    "velocity",
    "abilities",
    "buffs",
    "debuffs"
  ],
  "additionalProperties": false
}
