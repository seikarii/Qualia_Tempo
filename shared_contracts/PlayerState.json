{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlayerState",
  "description": "Player state data structure",
  "type": "object",
  "properties": {
    "position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "description": "X coordinate"
        },
        "y": {
          "type": "number", 
          "description": "Y coordinate"
        }
      },
      "required": ["x", "y"],
      "additionalProperties": false
    },
    "health": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Player health (0-100)"
    },
    "combo": {
      "type": "number",
      "minimum": 0,
      "description": "Current combo count"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "description": "Current score"
    },
    "isMoving": {
      "type": "boolean",
      "description": "Whether player is currently moving"
    },
    "lastRhythmHit": {
      "type": "number",
      "minimum": 0,
      "description": "Timestamp of last rhythm hit"
    }
  },
  "required": [
    "position",
    "health",
    "combo", 
    "score",
    "isMoving",
    "lastRhythmHit"
  ],
  "additionalProperties": false
}
